rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own /users doc to check their role. get() here does
    // not re-run these rules, so this does not recurse.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasValidCoordinates(data) {
      return (
        !('latitude' in data) &&
        !('longitude' in data)
      ) || (
        data.latitude is number &&
        data.longitude is number &&
        data.latitude >= -90 &&
        data.latitude <= 90 &&
        data.longitude >= -180 &&
        data.longitude <= 180
      );
    }

    function hasValidReportText(data) {
      return data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200 &&
        data.description is string &&
        data.description.size() > 0 &&
        data.description.size() <= 5000 &&
        data.locationText is string &&
        data.locationText.size() > 0 &&
        data.locationText.size() <= 500 &&
        data.city is string &&
        data.city.size() > 0 &&
        data.city.size() <= 100;
    }

    // ── users ────────────────────────────────────────────────────────────
    // Any signed-in user may look up another user's profile (name, avatar
    // initials, etc.) — required for Family Safety and Safe Walk guardian
    // display. Writes are restricted to the profile owner, and the `role`
    // field can never be changed by the client (prevents privilege escalation).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        !('role' in request.resource.data);
      allow update: if isOwner(userId) &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // ── incidents ────────────────────────────────────────────────────────
    // Public feed shows verified + public incidents to any signed-in user;
    // reporters can always see their own incidents regardless of status;
    // admins can see everything. Only admins may update (approve/reject).
    match /incidents/{incidentId} {
      allow read: if isSignedIn() &&
        (resource.data.visibility == 'public' ||
          resource.data.userId == request.auth.uid ||
          isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'location',
          'incidentCategory', 'locationText', 'city', 'severity',
          'markerType', 'safesphereVerified', 'verificationStatus',
          'visibility', 'userId', 'createdAt', 'updatedAt', 'status'
        ]) &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'location',
          'incidentCategory', 'locationText', 'city', 'latitude',
          'longitude', 'severity', 'markerType', 'safesphereVerified',
          'verificationStatus', 'visibility', 'userId', 'createdAt',
          'updatedAt', 'status', 'imageUrls'
        ]) &&
        hasValidReportText(request.resource.data) &&
        request.resource.data.category is string &&
        request.resource.data.incidentCategory is string &&
        request.resource.data.severity in ['low', 'medium', 'high'] &&
        request.resource.data.markerType == 'incident' &&
        request.resource.data.status == 'open' &&
        hasValidCoordinates(request.resource.data) &&
        (!('imageUrls' in request.resource.data) ||
          (request.resource.data.imageUrls is list &&
            request.resource.data.imageUrls.size() <= 3)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            request.resource.data.safesphereVerified == false &&
            request.resource.data.verificationStatus == 'pending' &&
            request.resource.data.visibility == 'pending'
          ) ||
          (
            isAdmin() &&
            request.resource.data.safesphereVerified == true &&
            request.resource.data.verificationStatus == 'verified' &&
            request.resource.data.visibility == 'public'
          )
        );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── infrastructureReports ───────────────────────────────────────────
    // Signed-in residents can use civic hazards in Area Health and route
    // safety calculations. Reporters create their own reports; municipal
    // status/severity updates remain admin-only.
    match /infrastructureReports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.visibility == 'public' ||
          resource.data.userId == request.auth.uid ||
          isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'locationText', 'city',
          'severity', 'status', 'verificationStatus', 'visibility',
          'userId', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'locationText', 'city',
          'latitude', 'longitude', 'severity', 'status',
          'verificationStatus', 'visibility', 'userId', 'createdAt', 'updatedAt'
        ]) &&
        hasValidReportText(request.resource.data) &&
        request.resource.data.category is string &&
        request.resource.data.severity in ['low', 'medium', 'high'] &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.verificationStatus == 'pending' &&
        request.resource.data.visibility == 'pending' &&
        hasValidCoordinates(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── notifications ────────────────────────────────────────────────────
    // Any signed-in user may create a notification addressed to another
    // user (e.g. a Safe Walk walker notifying their guardians) — this is
    // "send a message to a known uid", not open write access, since only
    // authenticated requests are accepted and the recipient is fixed by the
    // document's `userId` field. Only the recipient can read their own
    // notifications, and the only field they may ever change is `isRead`.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'isRead']) &&
        request.resource.data.isRead == false;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── familyLinks ──────────────────────────────────────────────────────
    // A link may only be created by the "child" side redeeming an invite
    // code for themselves, and may only be read/removed by one of its two
    // participants (the linked adult or child).
    match /familyLinks/{linkId} {
      allow read: if isSignedIn() &&
        (resource.data.adultId == request.auth.uid ||
          resource.data.childId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.childId == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.adultId == request.auth.uid ||
          resource.data.childId == request.auth.uid);
      allow update: if false;
    }

    // ── inviteCodes ──────────────────────────────────────────────────────
    // Codes can only be generated by the adult they belong to. Redeeming a
    // code requires looking it up by value, so reads stay signed-in-only
    // (the 6-digit code itself is the secret); the only mutation allowed is
    // flipping `used` from false to true, and no other field may change.
    match /inviteCodes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.adultId == request.auth.uid &&
        request.resource.data.used == false;
      allow update: if isSignedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);
      allow delete: if false;
    }

    // ── bugReports ───────────────────────────────────────────────────────
    // Users may file a bug report for themselves; only admins can review them.
    match /bugReports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── safeWalks (Safe Walk / Guardian Journey) ────────────────────────
    // A walk is only visible to the walker who owns it and the guardians
    // it lists. Only the walker's own device may create or update it
    // (location pings, status/progress changes); guardians are read-only
    // and can never be added/removed via a client-side update.
    match /safeWalks/{walkId} {
      allow read: if isSignedIn() &&
        (resource.data.walkerId == request.auth.uid ||
          request.auth.uid in resource.data.guardianIds);

      allow create: if isSignedIn() &&
        request.resource.data.walkerId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.guardianIds is list;

      allow update: if isSignedIn() &&
        resource.data.walkerId == request.auth.uid &&
        request.resource.data.walkerId == resource.data.walkerId &&
        request.resource.data.guardianIds == resource.data.guardianIds;

      allow delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
